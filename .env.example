# Public variables used by the frontend in local Docker Compose.
# The frontend talks directly to the Go backend; no hosted Supabase is needed.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Optional operator account ensured on every backend startup so an admin can
# always log in and call POST /api/admin/reseed to populate demo data.
# Login phone is used as-is (e.g. +254700000099).
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=AMATSI Admin
