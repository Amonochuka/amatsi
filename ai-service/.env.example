# Comma-separated browser origins permitted to call the service.
ALLOWED_ORIGINS=http://localhost:3000,https://amatsi.vercel.app
LOG_LEVEL=INFO

# KijaniBox land-climate API (leave empty to skip live enrichment).
KIJANIBOX_BASE_URL=https://api.kijanibox.example
KIJANIBOX_API_KEY=
KIJANIBOX_TIMEOUT_SECONDS=10

# Offline demo/testing: serve deterministic fixtures instead of the live API.
# KIJANIBOX_USE_MOCK=true
# KIJANIBOX_MOCK_SCENARIO=normal|dry|rainy|saturated
