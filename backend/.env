# ============================================================================
# KijaniFarmer Backend — Environment Variables
# Copy this to .env and fill in your actual values.
# ============================================================================

# Server port (default: 8080)
PORT=8080

# Supabase PostgreSQL connection string (REQUIRED)
# Format: postgresql://postgres:[password]@[host]:[port]/postgres
SUPABASE_DB_URL=

# JWT secret for signing tokens (REQUIRED)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# KijaniBox API credentials (REQUIRED)
KIJANIBOX_API_KEY=
KIJANIBOX_BASE_URL=https://api.kijanibox.com

# Africa's Talking SMS credentials (REQUIRED)
AFRICA_TALKING_API_KEY=
AFRICA_TALKING_USERNAME=
AFRICA_TALKING_SENDER_ID=KijaniFarmer
AFRICA_TALKING_CALLBACK_URL=

# Redis / Upstash URL (REQUIRED)
# Format: redis://default:[password]@[host]:[port]
REDIS_URL=

# Python AI Service URL (REQUIRED)
# Format: http://localhost:8000 or your Railway URL
AI_SERVICE_URL=

# CORS allowed origins (comma-separated)
# Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Gin mode: "debug" or "release"
GIN_MODE=debug
