# Server
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STRICT_PER_MINUTE=10

# Supabase / PostgreSQL — LOCAL DEV POSTGRES (docker compose).
# TODO: replace with your real Supabase URL, e.g.
# postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=postgres://amatsi:amatsi_dev_password@localhost:5433/amatsi?sslmode=disable

# Authentication
JWT_SECRET=amatsi-dev-secret-change-me

# KijaniSpace / SpaceIoTBox — placeholder until you add a real token
KIJANIBOX_API_KEY=dev-placeholder
KIJANIBOX_BASE_URL=https://api.kijanispace.eu

# Africa's Talking — placeholders until sandbox keys are added
AFRICA_TALKING_API_KEY=dev-placeholder
AFRICA_TALKING_USERNAME=sandbox
AFRICA_TALKING_SENDER_ID=AMATSI
AFRICA_TALKING_CALLBACK_URL=

# Redis / Asynq (local docker)
REDIS_URL=redis://localhost:6379/0

# Python AI service
AI_SERVICE_URL=http://localhost:8001

# Optional MQTT broker for premium irrigation devices
MQTT_BROKER_URL=
