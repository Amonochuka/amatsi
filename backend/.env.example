# ============================================================================
# KijaniFarmer Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control.
# ============================================================================

# Server port (default: 8080)
PORT=8080

# Supabase PostgreSQL connection string (REQUIRED)
# Use the SESSION POOLER URL from Supabase → Project Settings → Database
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# JWT secret for signing tokens (REQUIRED)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret-string

# KijaniSpace / SpaceIoTBox (REQUIRED)
# Get a Bearer access token from https://api.kijanispace.eu/docs
KIJANIBOX_API_KEY=your-kijanibox-jwt-bearer-token
KIJANIBOX_BASE_URL=https://api.kijanispace.eu

# Africa's Talking SMS (REQUIRED)
# Get your API key from https://account.africastalking.com
AFRICA_TALKING_API_KEY=your-africastalking-api-key
AFRICA_TALKING_USERNAME=sandbox
AFRICA_TALKING_SENDER_ID=AMATSI
AFRICA_TALKING_CALLBACK_URL=

# Redis / Upstash (REQUIRED)
# Use rediss:// (with double-s) for TLS-enabled hosted Redis (e.g. Upstash)
# Format: rediss://default:[password]@[host]:[port]
REDIS_URL=rediss://default:your-redis-password@your-host.upstash.io:6379

# Python AI Service URL (REQUIRED)
# Local development: http://localhost:8000
# Production: your Render service URL
AI_SERVICE_URL=https://amatsi-ai.onrender.com

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://amatsi.vercel.app,https://amatsi-git-main-amatsi.vercel.app

# Gin mode: "debug" or "release"
GIN_MODE=debug

# Optional: MQTT broker for premium IoT irrigation devices
MQTT_BROKER_URL=

# Rate limiting (defaults applied if unset)
# Requests per minute per IP for regular endpoints (default: 60)
RATE_LIMIT_PER_MINUTE=60
# Requests per minute per IP for write/expensive endpoints, e.g. generating
# recommendations and sending alerts (default: 10)
RATE_LIMIT_STRICT_PER_MINUTE=10
