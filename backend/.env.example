# Server
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000,https://amatsi.vercel.app
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STRICT_PER_MINUTE=10

# Supabase / PostgreSQL
SUPABASE_DB_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Authentication
JWT_SECRET=amatsi-secret-key

# KijaniSpace / SpaceIoTBox. Use a Bearer access token from
# https://api.kijanispace.eu/docs for development. Tokens may expire.
KIJANIBOX_API_KEY=
KIJANIBOX_BASE_URL=https://api.kijanispace.eu

# Africa's Talking
AFRICA_TALKING_API_KEY=
AFRICA_TALKING_USERNAME=sandbox
AFRICA_TALKING_SENDER_ID=AMATSI
AFRICA_TALKING_CALLBACK_URL=

# Redis / Asynq. Use rediss:// for hosted Upstash Redis.
REDIS_URL=rediss://default:[password]@[host]:6379

# Python AI service
AI_SERVICE_URL=http://localhost:8001

# Optional MQTT broker for premium irrigation devices
MQTT_BROKER_URL=
